{
  "name": "opencode-railway-computer",
  "version": "0.1.0",
  "description": "Give OpenCode agents a Railway computer: run subagents, builds, and previews in Railway VMs instead of your laptop",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "dependencies": {
    "@opencode/plugin": "2.3.0",
    "railway": "^3.17.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "solid-js": "^1.9",
    "typescript": "^5.9.0",
    "vite": "^7",
    "vite-plugin-solid": "^2.11"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "bun test",
    "typecheck": "tsc -p .",
    "prepublishOnly": "vite build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "railway",
    "sandbox",
    "remote-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-abdelwahab/opencode-railway-computer.git"
  },
  "engines": {
    "node": ">=22"
  }
}
